▌ [1mdb/migrations/20260917101500_add_orders_index.sql[m

  ✖ [1merror[m [1mMR101[m Index creation blocks writes on "orders"

     ╭─ db/migrations/20260917101500_add_orders_index.sql:2:1
   1 │ BEGIN;
   2 │ CREATE INDEX idx_orders_created_at ON orders (created_at);
     │ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     │
     ├─ lock    SHARE on orders · blocks INSERT, UPDATE, DELETE
     ├─ why     Postgres holds this lock until the whole index is built. INSERT, UPDATE and DELETE
     │          on the table wait for the entire build.
     ╰─ fix     Build the index concurrently, outside a transaction:

                CREATE INDEX CONCURRENTLY idx_orders_created_at ON orders (created_at);

  ▲ [1mwarning[m [1mMR403[m No lock_timeout before locking DDL

     ╭─ db/migrations/20260917101500_add_orders_index.sql:2:1
   1 │ BEGIN;
   2 │ CREATE INDEX idx_orders_created_at ON orders (created_at);
     │ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     │
     ├─ why     If a long query holds a lock on orders, this statement waits for it, and every query
     │          that arrives afterwards queues behind this statement.
     ╰─ fix     Set a lock timeout at the top of the migration, and retry the migration if it times
                out:

                SET lock_timeout = '5s';

