  ✖ [1merror[m [1mMR104[m Foreign key blocks writes on "orders" and "users"

     ╭─ db/migrations/20260917101600_add_orders_user_fk.sql:1:24
   1 │ ALTER TABLE orders ADD CONSTRAINT orders_user_id_fkey FOREIGN KEY (user_id) REFERENCES users…
     │                        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━…
     │
     ├─ lock    SHARE ROW EXCLUSIVE on orders, users · blocks INSERT, UPDATE, DELETE
     ├─ why     Postgres checks every existing row of orders against users while it holds locks on
     │          both tables. INSERT, UPDATE and DELETE on either table wait until the check
     │          finishes.
     ╰─ fix     Add the constraint as NOT VALID, then validate it in a separate transaction:

                1  Add the constraint without checking existing rows
                   ALTER TABLE orders ADD CONSTRAINT orders_user_id_fkey FOREIGN KEY (user_id) REFERENCES users (id) NOT VALID;

                2  Validate it in a separate migration
                   ALTER TABLE orders VALIDATE CONSTRAINT orders_user_id_fkey;

▌ [1mdb/migrations/20260917101700_widen_user_name.sql[m

  ▲ [1mwarning[m [1mMR201[m Changing the type of "users.name" may rewrite the table

     ╭─ db/migrations/20260917101700_widen_user_name.sql:1:1
   1 │ ALTER TABLE users ALTER COLUMN name TYPE varchar(255);
     │ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     │
     ├─ lock    ACCESS EXCLUSIVE on users · blocks reads and writes · rewrites the table
     ├─ why     Some changes to this type only update the catalog, such as varchar to text or a
     │          longer varchar limit. Other changes rewrite every row of users under an ACCESS
     │          EXCLUSIVE lock. migrail can't see the current column type in this migration.
     ╰─ fix     Change the type with expand and contract instead of rewriting the table in place:

                1  Add name_new with the new type
                   ALTER TABLE users ADD COLUMN name_new varchar(255);

                2  Write to both columns and backfill name_new in batches

                3  Read from name_new, then drop name and rename name_new

