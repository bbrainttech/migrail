        "sql": "CREATE INDEX idx_orders_status ON orders (status)",
        "inTransaction": false
      },
      "lock": {
        "mode": "SHARE",
        "tables": [
          "orders"
        ],
        "blocks": [
          "INSERT",
          "UPDATE",
