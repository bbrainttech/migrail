      "slug": "create-index-non-concurrent",
      "severity": "error",
      "confidence": "definite",
      "title": "Index creation blocks writes on \"orders\"",
      "why": "Postgres holds this lock until the whole index is built. INSERT, UPDATE and DELETE on the table wait for the entire build.",
      "location": {
        "path": "../../testdata/sql/MR101/bad/basic.sql",
        "start": {
          "line": 1,
          "column": 1,
          "offset": 0
        },
        "end": {
          "line": 1,
          "column": 50,
          "offset": 49
        }
      },
      "statement": {
        "index": 0,
        "sql": "CREATE INDEX idx_orders_status ON orders (status)",
        "inTransaction": false
      },
      "lock": {
        "mode": "SHARE",
        "tables": [
          "orders"
        ],
        "blocks": [
          "INSERT",
          "UPDATE",
          "DELETE"
        ],
        "rewrite": false,
        "scan": true
      },
      "fix": {
        "summary": "Build the index concurrently, outside a transaction:",
        "framework": "sql",
        "steps": [
          {
            "lang": "sql",
            "code": "CREATE INDEX CONCURRENTLY idx_orders_status ON orders (status);"
          }
        ]
      },
