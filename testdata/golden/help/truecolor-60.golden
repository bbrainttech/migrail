 [38;2;139;141;152mcatch dangerous migrations[m
 [38;2;139;141;152mbefore they reach production[m

  [38;2;230;230;234mmigrail reads your migrations the way the database runs[m
  [38;2;230;230;234mthem. It reports statements that lock tables, rewrite them[m
  [38;2;230;230;234mor break code that's still running, and shows how to fix[m
  [38;2;230;230;234meach one.[m

  [1;38;2;124;140;255mUsage[m
    [38;2;230;230;234mmigrail <command> [flags][m

  [1;38;2;124;140;255mCommands[m
    [1;38;2;230;230;234mcheck       [m[38;2;230;230;234mCheck SQL migrations for locks, rewrites and breaking changes[m
    [1;38;2;230;230;234mexplain     [m[38;2;230;230;234mExplain what a rule detects and how to fix it[m
    [1;38;2;230;230;234mrules       [m[38;2;230;230;234mList every rule with its severity and category[m
    [1;38;2;230;230;234mversion     [m[38;2;230;230;234mPrint the migrail version and build details[m

  [1;38;2;124;140;255mFlags[m
        [1;38;2;230;230;234m--ascii[m           [38;2;230;230;234muse ASCII symbols instead[m
  [38;2;230;230;234m                        of Unicode[m
        [1;38;2;230;230;234m--color string[m    [38;2;230;230;234muse color: auto, always or[m
  [38;2;230;230;234m                        never (default "auto")[m
        [1;38;2;230;230;234m--no-hyperlinks[m   [38;2;230;230;234mdon't print clickable file[m
  [38;2;230;230;234m                        links[m
        [1;38;2;230;230;234m--theme string[m    [38;2;230;230;234mcolor theme: auto, dark,[m
  [38;2;230;230;234m                        light or mono (default "auto")[m

  [38;2;139;141;152mRun [m[38;2;230;230;234mmigrail <command> --help[m[38;2;139;141;152m for details on a command.[m
